data: {"type":"content_block_delta","index":0,"delta":{"type":"input_json_delta","partial_json":"not json"}}

data: {"type":"content_block_start","index":1,"content_block":{"type":"tool_use","id":"t2","name":"list"}}

data: {"type":"message_stop"}

