: Anthropic Messages API stream (POST /v1/messages, anthropic-version
: 2023-06-01). A two-call PARALLEL BATCH: one text block, then two tool_use
: blocks on consecutive indices, both naming the SAME tool.
:
: Same-tool is the case the whole tool-call-id change exists for. Correlating
: a result back to its call by tool name has two answers here and picks one,
: which feeds the model file a's contents as the answer to the read of b. Only
: toolu_01A and toolu_01B tell the two apart, and the ids in this fixture are
: the only place a test can get them without inventing them.
:
: The usage on message_start is a cache hit: input_tokens counts only what was
: billed fresh, and the other two are siblings that have to be added to it for
: the prompt size and split off it for the price.
:
: Lines starting with a colon are SSE comments. Both adapters skip every line
: that does not begin with "data" plus a colon, so this header travels with
: the bytes without changing what is parsed.
:
: Transcribed from the shape anthropic::tests::
: a_two_call_batch_produces_a_body_the_messages_api_accepts asserts, plus the
: streaming envelope a live turn carries. See the header of
: tests/recorded_provider.rs for how to re-record it from a live stream once
: the adapter's dump hook exists.

event: message_start
data: {"type":"message_start","message":{"type":"message","role":"assistant","model":"claude-opus-5","content":[],"stop_reason":null,"usage":{"input_tokens":1200,"cache_read_input_tokens":44000,"cache_creation_input_tokens":900}}}

event: content_block_start
data: {"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Reading both."}}

event: content_block_stop
data: {"type":"content_block_stop","index":0}

event: content_block_start
data: {"type":"content_block_start","index":1,"content_block":{"type":"tool_use","id":"toolu_01A","name":"read_file","input":{}}}

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"input_json_delta","partial_json":"{\"path\":"}}

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"input_json_delta","partial_json":"\"a\"}"}}

event: content_block_stop
data: {"type":"content_block_stop","index":1}

event: content_block_start
data: {"type":"content_block_start","index":2,"content_block":{"type":"tool_use","id":"toolu_01B","name":"read_file","input":{}}}

event: content_block_delta
data: {"type":"content_block_delta","index":2,"delta":{"type":"input_json_delta","partial_json":"{\"path\":\"b\"}"}}

event: content_block_stop
data: {"type":"content_block_stop","index":2}

event: message_delta
data: {"type":"message_delta","delta":{"stop_reason":"tool_use"},"usage":{"output_tokens":47}}

event: message_stop
data: {"type":"message_stop"}
